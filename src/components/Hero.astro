---
import { Image } from "astro:assets";
import ListFarmModal from "./ListFarmModal.astro";

// Load all hero/profile images with proper typing
const images = import.meta.glob<{ default: string }>("/src/assets/profile-images/*.{jpg,jpeg,png}", {
  eager: true,
});

const slide = Astro.props.slide || {
  image: "coffefarm01.jpg",
  title: "Coffee Farms Explorer",
  subtitle: "Find and connect with sustainable coffee farms around the world",
};

// Resolve hero image metadata safely
const heroImg = images[`/src/assets/profile-images/${slide.image}`]?.default ?? null;
const modalId = "list-farm-modal";
---

<section class="relative w-full h-[70vh] md:h-[70vh] overflow-hidden">
  <!-- Background Image -->
  {heroImg && (
    <Image
      src={heroImg}
      alt={slide.title}
      class="absolute inset-0 w-full h-full object-cover"
      widths={[600, 900, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      format="webp"
    />
  )}

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/30"></div>

  <!-- Hero Content -->
  <div class="relative z-10 flex flex-col justify-center h-full px-6 sm:px-6 md:px-0 mx-auto w-full md:w-3/4 text-white">
    <h1 class="text-4xl md:text-6xl font-extrabold mb-4 drop-shadow-lg">{slide.title}</h1>
    <p class="text-lg md:text-2xl mb-6 drop-shadow-md">{slide.subtitle}</p>

    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="#farms-container"
        class="inline-flex items-center justify-center bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-3 rounded-lg shadow-lg transition-colors"
      >
        Explore Farms
      </a>

      <button
        id="list-farm-btn"
        type="button"
        class="inline-block bg-white text-emerald-600 hover:bg-emerald-100 font-semibold px-6 py-3 rounded-lg shadow-lg transition-colors"
      >
        List Your Farm
      </button>
    </div>
  </div>
</section>

<ListFarmModal id={modalId} />

<script>
  const btn = document.getElementById("list-farm-btn");
  const modal = document.getElementById("list-farm-modal");
  btn?.addEventListener("click", () => modal?.showModal());
</script>
